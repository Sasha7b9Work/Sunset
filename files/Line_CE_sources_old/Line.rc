IDR_MENUFLOATINGFILE MENU DISCARDABLE 
BEGIN
    POPUP "Меню всплывающее"
    BEGIN
        MENUITEM "Новый...",                    IDR_FILE_NEW
        MENUITEM "Открыть...",                  IDR_FILE_OPEN
        MENUITEM "Закрыть",                     IDR_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Сохранить",                   IDR_FILE_SAVE
        MENUITEM "Сохранить как...",            IDR_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Удалить...",                  IDC_FILE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Выход",                       IDR_FILE_EXIT
    END
END

IDR_MENUFLOATINGTEST MENU DISCARDABLE 
BEGIN
    POPUP "Меню всплывающее"
    BEGIN
        POPUP "Добавить"
        BEGIN
            MENUITEM "активный...",                 ID_ADD_TREEFROMPANEL
            MENUITEM "из библиотеки...",            ID_ADD_TREEFROMMEMORY
        END
        MENUITEM SEPARATOR
        MENUITEM "Сохранить параметры",         ID_MODIFY
        MENUITEM SEPARATOR
        MENUITEM "Удалить",                     ID_DEL
        MENUITEM "Удалить всё",                 ID_DEL_ALL
        MENUITEM SEPARATOR
        MENUITEM "Копировать",                  ID_COPY
        MENUITEM "Вставить",                    ID_PASTE
        MENUITEM "Переименовать...",            ID_TEST_RENAME
        MENUITEM SEPARATOR
        POPUP "Библиотека тестов"
        BEGIN
            MENUITEM "стандартных",                 ID_DEL_TST_STANDART
            MENUITEM "пользовательских",            ID_DEL_TST_USER
        END
        MENUITEM SEPARATOR
        POPUP "Сохранить в библиотеке"
        BEGIN
            MENUITEM "стандартных тестов...",       ID_TST_STANDART
            MENUITEM "пользовательских тестов...",  ID_TST_USER
        END
    END
END

IDR_MENUFLOATINGTUNING MENU DISCARDABLE 
BEGIN
    POPUP "Меню всплывающее"
    BEGIN
        MENUITEM "Настройки пользователя...",   ID_PART
        POPUP "Запуск"
        BEGIN
            MENUITEM "внутренний",                  ID_ZAPUSK_INTERNAL
            MENUITEM "внешний",                     ID_ZAPUSK_EXTERNAL
        END
        POPUP "Автосохранение результатов"
        BEGIN
            MENUITEM "включить",                    ID_SOUND_ON
            MENUITEM "выключить",                   ID_SOUND_OFF
        END
        MENUITEM SEPARATOR
        MENUITEM "Разность ВАХ...",             ID_DIFFERENCE_VAX
        MENUITEM SEPARATOR
        MENUITEM "Коррекция смещения нуля...",  ID_AUTO_SETUP_NULL
        MENUITEM "Калибровка...",               ID_KALIBR
        MENUITEM "Таблица смещений и коэффициентов...", ID_TABL_COEF
        MENUITEM SEPARATOR
        MENUITEM "Изменить пароль...",          IDR_FILE_REPAROL
        MENUITEM "IP-адрес...",                 IDC_MODIFY_IP_ADDRESS
        MENUITEM "Мой компьютер...",            IDC_TUNING_COPYFILE
    END
END

IDR_MENUFLOATINGOTCHT MENU DISCARDABLE 
BEGIN
    POPUP "Меню всплывающее"
    BEGIN
        MENUITEM "Новый",                       ID_OTCHT_NEW
        MENUITEM SEPARATOR
        MENUITEM "Сохранить...",                ID_OTCHT_SAVE
        MENUITEM "Удалить...",                  IDC_DELETE_OTCH
        MENUITEM SEPARATOR
        MENUITEM "Развернуть",                  ID_OTCHT_MAX
        MENUITEM "Свернуть",                    ID_OTCHT_MIN
        MENUITEM "Закрыть",                     ID_OTCHT_MAIL
    END
END

IDR_MENUFLOATINGGRAF MENU DISCARDABLE 
BEGIN
    POPUP "Меню всплывающее"
    BEGIN
        POPUP "Размер точки"
        BEGIN
            MENUITEM "маленький",                   ID_POINT_SIZE_SMALL
            MENUITEM "большой",                     ID_POINT_SIZE_BIG
        END
        POPUP "Стиль кривой"
        BEGIN
            MENUITEM "линия",                       ID_CURVE_LINE
            MENUITEM "точки",                       ID_CURVE_POINT
            MENUITEM "линия с точками",             ID_CURVE_LINEWITHPOINT
        END
        POPUP "Цвет"
        BEGIN
            MENUITEM "фона",                        ID_COLOR_FON
            MENUITEM "сетки",                       ID_COLOR_SETKA
            MENUITEM "шрифта",                      ID_COLOR_FONT
            MENUITEM "кривой",                      ID_COLOR_CURVE
            MENUITEM "ссылки",                      ID_COLOR_REF
            MENUITEM "секущей",                     ID_COLOR_TANGENT
        END
        POPUP "Маркеры"
        BEGIN
            MENUITEM "активны",                     ID_MARKER_AKT
            MENUITEM "неактивны",                   ID_MARKER_NOAKT, CHECKED
        END
        MENUITEM "Шкала...",                    ID_GRAF_LUPA
        MENUITEM SEPARATOR
        MENUITEM "Сохранить график в архиве...", ID_SAVE_REF
        MENUITEM SEPARATOR
        MENUITEM "Сброс графика Ref",           ID_REF_RESET
    END
END

IDR_MENUFLOATINGMEMORY MENU DISCARDABLE 
BEGIN
    POPUP "Меню всплывающее"
    BEGIN
        MENUITEM "Очистить архив...",           ID_CLEAR_MEMORY
        MENUITEM SEPARATOR
        MENUITEM "Удалить из архива...",        ID_DEL_MEMORY
        MENUITEM "Загрузить из архива",         ID_EXTRACT_REF
        MENUITEM SEPARATOR
        MENUITEM "Открыть архив",               ID_LISTREF_OPEN
        MENUITEM "Закрыть архив",               ID_LISTREF_CLOSE
    END
END

IDR_MENUFLOATINGTABL MENU DISCARDABLE 
BEGIN
    POPUP "Меню исплывающее"
    BEGIN
        MENUITEM "Сохранить...",                ID_TABLRES_SAVE
        MENUITEM SEPARATOR
        MENUITEM "Удалить...",                  IDR_TABL_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Развернуть",                  ID_OPENTABL
        MENUITEM "Свернуть",                    ID_TABL_MIN
    END
END

